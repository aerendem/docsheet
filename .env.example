# Copy to `.env` and fill in. Only OPENROUTER_API_KEY is required.

# Required — create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Quality tiers map to specific models in src/lib/tiers.ts;
# users can also override the model per-request from the UI (Advanced options).
# MAX_UPLOAD_MB=25
# REQUEST_TIMEOUT_MS=240000
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional — sent to OpenRouter as HTTP-Referer (used for their app-ranking).
# Set this to your public Railway URL once deployed.
# APP_PUBLIC_URL=https://docsheet-production.up.railway.app

# Optional — barcode → name matcher. Catalogs are fetched from public sites and
# cached in memory; nothing here needs a key.
# CATALOG_TTL_MINUTES=720
# CATALOG_MAX_PRODUCTS=500
# CATALOG_TIMEOUT_MS=20000
# NATURE_NURTURE_URL=https://shop.naturenurture.com.tr
